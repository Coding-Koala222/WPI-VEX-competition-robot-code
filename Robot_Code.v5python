{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\nline_tracker_right = Line(brain.three_wire_port.a)\nline_tracker_left = Line(brain.three_wire_port.b)\n# AI Vision Color Descriptions\nai_vision_12__OrangeF = Colordesc(1, 227, 139, 108, 9, 0.1)\n# AI Vision Code Descriptions\nai_vision_12 = AiVision(Ports.PORT12, ai_vision_12__OrangeF)\nConveyer = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)\nArm_motor_a = Motor(Ports.PORT11, GearSetting.RATIO_18_1, True)\nArm_motor_b = Motor(Ports.PORT13, GearSetting.RATIO_18_1, False)\nArm = MotorGroup(Arm_motor_a, Arm_motor_b)\nleft_motor_a = Motor(Ports.PORT19, GearSetting.RATIO_18_1, True)\nleft_motor_b = Motor(Ports.PORT20, GearSetting.RATIO_18_1, True)\nleft_drive_smart = MotorGroup(left_motor_a, left_motor_b)\nright_motor_a = Motor(Ports.PORT17, GearSetting.RATIO_18_1, False)\nright_motor_b = Motor(Ports.PORT18, GearSetting.RATIO_18_1, False)\nright_drive_smart = MotorGroup(right_motor_a, right_motor_b)\ndrivetrain_inertial = Inertial(Ports.PORT6)\ndrivetrain = SmartDrive(left_drive_smart, right_drive_smart, drivetrain_inertial, 319.19, 320, 40, MM, 0.6)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\nvexcode_initial_drivetrain_calibration_completed = False\ndef calibrate_drivetrain():\n    # Calibrate the Drivetrain Inertial\n    global vexcode_initial_drivetrain_calibration_completed\n    wait(200, MSEC)\n    brain.screen.print(\"Calibrating\")\n    brain.screen.next_row()\n    brain.screen.print(\"Inertial\")\n    drivetrain_inertial.calibrate()\n    while drivetrain_inertial.is_calibrating():\n        wait(25, MSEC)\n    vexcode_initial_drivetrain_calibration_completed = True\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n\n\n# Calibrate the Drivetrain\ncalibrate_drivetrain()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n\n\n# define variables used for controlling motors based on controller inputs\ncontroller_1_left_shoulder_control_motors_stopped = True\ncontroller_1_right_shoulder_control_motors_stopped = True\n\n# define a task that will handle monitoring inputs from controller_1\ndef rc_auto_loop_function_controller_1():\n    global controller_1_left_shoulder_control_motors_stopped, controller_1_right_shoulder_control_motors_stopped, remote_control_code_enabled\n    # process the controller input every 20 milliseconds\n    # update the motors based on the input values\n    while True:\n        if remote_control_code_enabled:\n            # check the buttonL1/buttonL2 status\n            # to control Conveyer\n            if controller_1.buttonL1.pressing():\n                Conveyer.spin(FORWARD)\n                controller_1_left_shoulder_control_motors_stopped = False\n            elif controller_1.buttonL2.pressing():\n                Conveyer.spin(REVERSE)\n                controller_1_left_shoulder_control_motors_stopped = False\n            elif not controller_1_left_shoulder_control_motors_stopped:\n                Conveyer.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_left_shoulder_control_motors_stopped = True\n            # check the buttonR1/buttonR2 status\n            # to control Arm\n            if controller_1.buttonR1.pressing():\n                Arm.spin(FORWARD)\n                controller_1_right_shoulder_control_motors_stopped = False\n            elif controller_1.buttonR2.pressing():\n                Arm.spin(REVERSE)\n                controller_1_right_shoulder_control_motors_stopped = False\n            elif not controller_1_right_shoulder_control_motors_stopped:\n                Arm.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_right_shoulder_control_motors_stopped = True\n        # wait before repeating the process\n        wait(20, MSEC)\n\n# define variable for remote controller enable/disable\nremote_control_code_enabled = True\n\nrc_auto_loop_thread_controller_1 = Thread(rc_auto_loop_function_controller_1)\n\n#endregion VEXcode Generated Robot Configuration\n\n#----------------------------------------------\n\n# left_drive_smart = Motor(Ports.PORT1, GearSetting.RATIO_18_1, True)\n# right_drive_smart = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\n\n\ndef Square_Velocity_Distance_Turn(Square_Velocity_Distance_Turn__Velocity, Square_Velocity_Distance_Turn__Distance, Square_Velocity_Distance_Turn__Turn):\n    global myVariable\n    drivetrain.set_drive_velocity(Square_Velocity_Distance_Turn__Velocity, PERCENT)\n    for repeat_count in range(4):\n        drivetrain.drive_for(FORWARD, Square_Velocity_Distance_Turn__Distance, INCHES)\n        drivetrain.turn_for(RIGHT, Square_Velocity_Distance_Turn__Turn, DEGREES)\n        wait(5, MSEC)\n\ndef polygon(num_sides, distance):\n    \n    for repeat_count in range(num_sides): \n        drivetrain.drive_for(FORWARD, distance, INCHES,)\n        drivetrain.turn_for(RIGHT, 360 / num_sides, DEGREES)\n        print(\"Drawing side \" + \"repeat_count\")\n\ndef wave():\n    global myVariable\n    Arm.set_velocity(20, PERCENT)\n    Arm.spin_for(FORWARD, 50, DEGREES)\n    Arm.spin_for(REVERSE, 100, DEGREES)\n    Arm.spin_for(FORWARD, 100, DEGREES)\n    Arm.spin_for(REVERSE, 50, DEGREES)\n    Arm.set_velocity(50, PERCENT)\n\ndef square(side_length):\n    for repeat_count in range(4): \n        drivetrain.drive_for(FORWARD, side_length, INCHES, wait=True)\n        drivetrain.turn_for(RIGHT, 90, DEGREES)\n\n\n\n# Slows as robot gets closer to target\n# This is proportional movement\n\n# Units: proportional_movement(inches)\n# def set_target_distance(target_distance): \n#     scale_value = 3\n#     current_offset = range_finder_front.distance(INCHES) - target_distance\n    \n#     print(scale_value * current_offset)\n\n#     if (scale_value * current_offset) > 0:\n#         speed = scale_value * current_offset\n            \n#     elif (scale_value * current_offset < 0 and (scale_value * current_offset) < (target_distance + 2)):\n            \n#         speed = scale_value * current_offset\n            \n#     else:\n#         speed = 0\n\n#     drivetrain.set_drive_velocity(speed, PERCENT)\n\n#     drivetrain.drive(FORWARD)\n    \ndef follow_line():\n    speed_multiplier = 4\n    reflectivity_percent_multiplier = 0.50\n    final_reflectivity = (reflectivity_percent_multiplier * line_tracker_left.reflectivity(PERCENT)) - (reflectivity_percent_multiplier * line_tracker_right.reflectivity(PERCENT))\n    \n    #print(final_reflectivity)\n\n    left_drive_smart.set_velocity(50 + (speed_multiplier * (final_reflectivity)),PERCENT)\n    right_drive_smart.set_velocity(50 + (speed_multiplier * (final_reflectivity)),PERCENT)\n \n    drivetrain.drive(FORWARD)\n\ndef DetectObject():\n  \n  # takes a snapshot and searches for OrangeF\n  # you’ll want to use the signature that you defined above\n\n  objects = ai_vision_12.take_snapshot(ai_vision_12__OrangeF)\n\n  # print the coordinates of the center of the object\n  \n  if (objects):\n    #print(\"Number of objects: \" + type(objects))\n\n    print(\"Largest object: \")\n    print('x:', ai_vision_12.largest_object().centerX, '   y:',  ai_vision_12.largest_object().centerY, '   width:', ai_vision_12.largest_object().width)\n    brain.screen.print_at('x: ', ai_vision_12.largest_object().centerX, x = 50, y = 40)\n    brain.screen.print_at('   y:',  ai_vision_12.largest_object().centerY, x = 150, y = 40)\n    brain.screen.print_at('  width:', ai_vision_12.largest_object().width, x = 250, y = 40)\n    wait(100)\n    brain.screen.clear_screen()\n    \n\ndef find_objects_with_id(april_tag_id, item_list):\n    for item in item_list:\n        if item.get(\"id\") == april_tag_id:\n            return item\n\n# set_target_distance(6)\n\n# stop_cutoff_distance = 6\n\n# while True:\n#     # wait(1,SECONDS)\n#     # print(range_finder_front.distance(INCHES))\n\n#     if (range_finder_front.distance(INCHES) > stop_cutoff_distance + 2):\n#         follow_line()\n#     else:\n#         set_target_distance(stop_cutoff_distance)   \n\n#     # else: \n\n\n\n#--------------------------------------------------\n# Competititon Template\n\n\ndef pre_autonomous():\n    # actions to do when the program starts\n    brain.screen.clear_screen()\n    brain.screen.print(\"pre auton code\")\n    \n    drivetrain.set_stopping(BRAKE)\n    drivetrain.set_drive_velocity(100, PERCENT)\n    drivetrain.set_turn_velocity(100, PERCENT)\n\n    #calibrate_drivetrain()\n\ndef autonomous():\n   #brain.screen.clear_screen()\n    brain.screen.print(\"autonomous code\")\n\n    drivetrain.set_drive_velocity(25, PERCENT)\n    drivetrain.set_turn_velocity(100, PERCENT)\n    drivetrain.set_stopping(BRAKE)\n\n\n    Conveyer.set_velocity(100, PERCENT)\n    Arm.set_velocity(100, PERCENT)\n\n    while True:\n        # Take a snapshot to create an array of detected objects\n        \n        # ai_vision_12_objects = ai_vision_12.take_snapshot(ai_vision_12__BlueBox)\n\n        ai_vision_12_objects = ai_vision_12.take_snapshot(AiVision.ALL_TAGS)\n\n\n        # if snapshot_objects and len(snapshot_objects) > 0:\n        # # Determine if AprilTag is detected.\n        #     if snapshot_objects[0].id == 1:\n        #         # Conditional based on finding TagID #1.\n        #         brain.screen.print(\"Found TagID 1\")\n        #     elif snapshot_objects[0].id == 2:\n        #         # Conditional based on finding TagID #2.\n        #         brain.screen.print(\"Found TagID 2\")\n        #     else:\n        #         # Else condition will print any other TagID found.\n        #         brain.screen.print(\"Found TagID\")\n        #         brain.screen.next_row()\n        #         brain.screen.print(\"TagID: \")\n        #         brain.screen.print(snapshot_objects[0].id)\n\n            \n        # Check if there is an existing object at the start of the array\n       \n        # Determine if AprilTag is detected.\n        if find_objects_with_id(12, ai_vision_12_objects):\n            print(\"found id 12 april tag\")\n        \n        elif ai_vision_12_objects[0].id == 1:\n            # Conditional based on finding TagID #1.\n            brain.screen.print(\"Found TagID 1\")\n\n\n        # An object exists, so lets try and center the sensor on the object.\n        # The AI Vision Sensor returns a 320x240 frame, meaning centerX needs\n        # to be 160 for the Sensor to be centered on the object. For this\n        # example we will go with a center range of 130 < x < 190. This gives\n        # us an acceptable margin of error of 30px in either direction.\n            if ai_vision_12_objects[0].centerX > 190:\n                # turn in 5 degree increments to avoid the risk of turning too far\n                drivetrain.turn_for(RIGHT, 5, DEGREES)\n            elif ai_vision_12_objects[0].centerX < 130:\n                # turn in 5 degree increments to avoid the risk of turning too far\n                drivetrain.turn_for(LEFT, 5, DEGREES)\n            else:\n                # Now the object is centered, let's move closer to the object.\n                # Keep driving forward until the object height reaches 120.\n                if ai_vision_12_objects[0].height < 120:\n                    drivetrain.drive(FORWARD)\n                else:\n                    # Once the object height reaches 120, we know the object is\n                    # close since it is occupying 1/2 of the 320x240 frame.\n                    drivetrain.stop()\n\n            # Prepare to draw the video stream of the detected object in real time.\n            brain.screen.clear_screen()\n            brain.screen.set_pen_color(Color.BLUE)\n            brain.screen.set_fill_color(Color.BLUE)\n\n            # We must draw a line to represent the edge of the 320x240 frame.\n            # Any drawn object will not go outside of this barrier.\n            brain.screen.draw_line(320, 0, 320, 239)\n\n            # Using the properties of the existing object(i.e. BlueBox),\n            # we can draw the object on the Brain screen.\n            brain.screen.draw_rectangle(\n                ai_vision_12_objects[0].originX,\n                ai_vision_12_objects[0].originY,\n                ai_vision_12_objects[0].width,\n                ai_vision_12_objects[0].height)\n        else:\n            # No object detected, clear the brain screen and follow line.\n            brain.screen.clear_screen()\n            follow_line()\n            wait(5,MSEC)\n\ndef user_control():\n    brain.screen.clear_screen()\n    # place driver control in this while loop\n\n    drivetrain.set_drive_velocity(30, PERCENT)\n    drivetrain.set_turn_velocity(30, PERCENT)\n    drivetrain.set_stopping(BRAKE)\n\n\n    Conveyer.set_velocity(100, PERCENT)\n    Arm.set_velocity(100, PERCENT)\n\n\n\n    # Default speed configuration\n    DEFAULT_SPEED_MULTIPLIER = 0.6   # 60% default top speed\n    speed_multiplier = DEFAULT_SPEED_MULTIPLIER\n    STEP = 0.05                      # step when adjusting with buttons\n    MIN_MULT = 0.2\n    MAX_MULT = 1.0\n\n    DEADBAND = 5  # joystick deadzone (percent)\n\n    def apply_motor_group_speed(group, value_percent):\n        \"\"\"Set direction and velocity for a MotorGroup based on signed percent value (-100..100).\"\"\"\n        if abs(value_percent) <= DEADBAND:\n            group.stop()  # small joystick -> stop (coast/hold behavior can be changed)\n            return\n        mag = min(abs(value_percent), 100)\n        group.set_velocity(mag * 1.0, PERCENT)\n        if value_percent > 0:\n            group.spin(FORWARD)\n        else:\n            group.spin(REVERSE)\n\n    # Main loop\n    while True:\n        # Read joystick (arcade: forward/back + turning)\n        forward = controller_1.axis3.position()  # -100 .. 100\n        turn = controller_1.axis1.position()     # -100 .. 100\n\n        # Compute left/right speeds and apply multiplier\n        left_speed = (forward + turn) * speed_multiplier\n        right_speed = (forward - turn) * speed_multiplier\n\n        # Send to motor groups\n        apply_motor_group_speed(left_drive_smart, left_speed)\n        apply_motor_group_speed(right_drive_smart, right_speed)\n\n        # Buttons to adjust default multiplier (customize mapping if your layout differs)\n        # D-pad Up increases speed, D-pad Down decreases speed, Button A resets to default\n        if controller_1.buttonUp.pressing():\n            speed_multiplier = min(speed_multiplier + STEP, MAX_MULT)\n            wait(200, MSEC)  # simple debounce / step limiter\n        elif controller_1.buttonDown.pressing():\n            speed_multiplier = max(speed_multiplier - STEP, MIN_MULT)\n            wait(200, MSEC)\n\n        if controller_1.buttonA.pressing():\n            speed_multiplier = DEFAULT_SPEED_MULTIPLIER\n            wait(200, MSEC)\n\n        # Display values for debugging\n        # brain.screen.clear_line(1)\n        # brain.screen.print_at(\"Speed mult: {:.2f}\".format(speed_multiplier), 10, 20)\n        # brain.screen.print_at(\"L:{:.0f} R:{:.0f}\".format(left_speed, right_speed), 10, 40)\n\n        wait(20, MSEC)\n\n# create competition instance\ncomp = Competition(user_control, autonomous)\npre_autonomous()\n\n    \n\n","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"Conveyer","leftDir":"false","right":"Arm","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[1],"name":"line_tracker_right","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{"id":"partner"},"triportSourcePort":22},{"port":[2],"name":"line_tracker_left","customName":true,"deviceType":"LineTracker","deviceClass":"line","setting":{"id":"partner"},"triportSourcePort":22},{"port":[12],"name":"ai_vision_12","customName":false,"deviceType":"AIVision","deviceClass":"aivision","setting":{"config":"{\"colors\":[{\"id\":1,\"name\":\"OrangeF\",\"nameValid\":\"Valid\",\"lastValidName\":\"OrangeF\",\"red\":226.8547142857143,\"green\":138.87290476190475,\"blue\":108.19647619047619,\"hueRange\":9,\"saturationRange\":0.1}],\"codes\":[],\"tags\":false,\"AIObjects\":false,\"AIObjectModel\":[\"Ball(Blue)\",\"Ball(Green)\",\"Ball(Red)\",\"Ring(Blue)\",\"Ring(Green)\",\"Ring(Red)\",\"Cube(Blue)\",\"Cube(Green)\",\"Cube(Red)\"],\"AIModelMetadata\":{\"id\":0,\"version\":1,\"name\":\"Classroom Objects\"},\"aiModelDropDownValue\":0}","isConfigured":"false"},"triportSourcePort":22},{"port":[10],"name":"Conveyer","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[11,13],"name":"Arm","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[19,20,17,18,6],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"wheel4in","gear":"ratio18_1","gearRatio":"3:5","direction":"rev","gyroType":"inertial","width":"295","unit":"mm","wheelbase":"40","wheelbaseUnit":"mm","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.65.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}